{
  "expo": {
    "name": "D-Score Gymnastics",
    "slug": "d-score-gymnastics",
    "version": "1.0.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android", "web"],
    "scheme": "dscoregymnastics",
    "web": {
      "backgroundColor": "#f4f6f8",
      "bundler": "metro",
      "description": "Local-first men's artistic gymnastics difficulty scoring.",
      "display": "standalone",
      "favicon": "./assets/favicon.png",
      "lang": "en",
      "output": "single"
    },
    "extra": {
      "eas": {
        "projectId": "2fd7ce07-2b46-41fd-94d1-e4e6eb50746d"
      }
    },
    "owner": "gcins-team",
    "ios": {
      "bundleIdentifier": "com.gcinsteam.dscoregymnastics",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#101828",
        "foregroundImage": "./assets/icon.png"
      },
      "package": "com.gcinsteam.dscoregymnastics"
    },
    "splash": {
      "backgroundColor": "#f4f6f8",
      "image": "./assets/icon.png",
      "resizeMode": "contain"
    }
  }
}
